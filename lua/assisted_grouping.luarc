
-- assisted_grouping: loads the plugin and writes "loaded" or "FAILED <reason>" to dt-lua-errors.txt
do
    local ok, e = pcall(require, "contrib/assisted_grouping")
    local f = io.open(require("darktable").configuration.config_dir .. "/dt-lua-errors.txt", "a")
    f:write("assisted_grouping ", ok and "loaded" or ("FAILED " .. tostring(e)), "\n")
    f:close()
end
